# LocalForge .gitignore

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Rust & Cargo
/target/
crates/**/target/
apps/**/target/
tools/**/target/
**/*.rs.bk
*.pdb

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
*.local

# Tauri build artifacts
src-tauri/target/
apps/desktop/src-tauri/target/

# IDE & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Environment & Credentials (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
*.keystore
id_rsa
id_ecdsa
id_ed25519
known_hosts

# LocalForge Runtime Local Data & Caches (when run locally in dev)
.localforge/secrets/
.localforge/cache/
.localforge/run/
.localforge/*.sock
.localforge/logs/
/tmp/
/run/

# Test & Coverage Outputs
coverage/
*.lcov
*.profraw
*.profdata
report.html
scratch/
